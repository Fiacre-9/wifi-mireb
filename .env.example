# Copiez ce fichier en .env (local) ou saisissez ces variables dans Hostinger. NE JAMAIS pousser le vrai token sur GitHub.
FLEXPAY_MERCHANT=MARCO_SERVICE
FLEXPAY_TOKEN=Bearer VOTRE_TOKEN_FLEXPAIE
TICKET_PRICE=1000
TICKET_CURRENCY=CDF
ADMIN_PASSWORD=choisissez_un_mot_de_passe_long
SESSION_SECRET=une_longue_chaine_aleatoire
# URL publique du site (pour les callbacks FlexPay), sans slash final
BASE_URL=https://votre-domaine.com
# Dossier de stockage persistant (codes + commandes)
DATA_DIR=./data
